Subject: refactor(dashboard-api): rename averageBatteryPercent to avgBatteryPercent

Aligns the fleet summary with the dashboard UI naming. The field rename is intentional;
unit tests were updated in the same change. Consumers must switch to avgBatteryPercent.

---
diff --git a/services/dashboard-api/src/lib/fleetSummary.js b/services/dashboard-api/src/lib/fleetSummary.js
index 33a3d03..9b21982 100644
--- a/services/dashboard-api/src/lib/fleetSummary.js
+++ b/services/dashboard-api/src/lib/fleetSummary.js
@@ -21,7 +21,7 @@ function summarizeFleet(snapshots, now = Date.now()) {
 
   return {
     vehicleCount: snapshots.length,
-    averageBatteryPercent: avgBattery,
+    avgBatteryPercent: avgBattery,
     statusCounts: counts,
     needsAttention: vehicles
       .filter((v) => v.status === 'CRITICAL' || v.status === 'WARNING')
diff --git a/services/dashboard-api/test/fleetSummary.test.js b/services/dashboard-api/test/fleetSummary.test.js
index 457481d..2f9300f 100644
--- a/services/dashboard-api/test/fleetSummary.test.js
+++ b/services/dashboard-api/test/fleetSummary.test.js
@@ -10,7 +10,7 @@ describe('summarizeFleet', () => {
     const summary = summarizeFleet(demoSnapshots(NOW), NOW);
 
     expect(summary.vehicleCount).toBe(3);
-    expect(summary.averageBatteryPercent).toBe(49);
+    expect(summary.avgBatteryPercent).toBe(49);
     expect(summary.statusCounts).toEqual({ OK: 1, INFO: 0, WARNING: 1, CRITICAL: 1 });
     expect(summary.needsAttention).toEqual(['VIN-1002', 'VIN-1003']);
   });
@@ -18,7 +18,7 @@ describe('summarizeFleet', () => {
   test('handles an empty fleet', () => {
     expect(summarizeFleet([], NOW)).toEqual({
       vehicleCount: 0,
-      averageBatteryPercent: null,
+      avgBatteryPercent: null,
       statusCounts: { OK: 0, INFO: 0, WARNING: 0, CRITICAL: 0 },
       needsAttention: [],
       vehicles: [],
